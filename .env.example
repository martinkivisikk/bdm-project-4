# Copy to .env and adjust as needed. Never commit .env.

# PostgreSQL
POSTGRES_DB=rico
POSTGRES_USER=rico
POSTGRES_PASSWORD=rico

# MinIO
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rico-raw

# Ollama
OLLAMA_MODEL=qwen2.5:3b

# Airflow Fernet key — used to encrypt connection passwords stored in the DB.
# Generate your own: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=ZmDfmkgGkAh0d5ut3lsERVa-OiCJKiJKqquVJFtZVCM=

# Slack (optional — leave blank to disable run notifications)
SLACK_WEBHOOK_URL=

# Debug 
DEBUG_FORCE_AUDIT_FAIL=false
# If true, audit task will inject a synthetic duplicate entry to simulate a failing audit.
# Used only for testing failure handling and DAG interruption behavior.

DEBUG_EVAL_SINGLE_SCREEN=false
# If true, eval task restricts evaluation to a single screen (screens[:1]).
# Used to speed up iteration and debug retrieval logic on a minimal dataset.
# If false, eval runs on all screens in the current run.

DEBUG_EVAL_ASSERT_SELF=false
# If true, eval task enforces a hard check that the queried screen_id
# must appear in the top-5 nearest neighbours.
# If violated, the task raises an exception and fails the DAG.
# Used to detect broken embedding retrieval or similarity issues early.